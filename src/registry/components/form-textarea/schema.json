{
  "displayName": "多行文本框",
  "category": "form",
  "defaultCode": "<FormTextarea />",
  "importCode": "import { FormTextarea } from '@/components/kesi/form-textarea/form-textarea';",
  "props": [
    {
      "name": "placeholder",
      "label": "占位符",
      "type": "text",
      "default": "请输入内容"
    },
    {
      "name": "variant",
      "label": "样式变体",
      "type": "select",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "默认"
        },
        {
          "value": "outline",
          "label": "边框"
        },
        {
          "value": "filled",
          "label": "填充"
        },
        {
          "value": "ghost",
          "label": "幽灵"
        }
      ]
    },
    {
      "name": "disabled",
      "label": "禁用",
      "type": "boolean",
      "default": false
    },
    {
      "name": "readOnly",
      "label": "只读",
      "type": "boolean",
      "default": false
    },
    {
      "name": "allowClear",
      "label": "显示清除按钮",
      "type": "boolean",
      "default": false
    },
    {
      "name": "showCount",
      "label": "显示字数统计",
      "type": "boolean",
      "default": false
    },
    {
      "name": "delBlank",
      "label": "去除空格",
      "type": "boolean",
      "default": false,
      "description": "失焦时自动去除首尾空格"
    },
    {
      "name": "defaultVal",
      "label": "默认值",
      "type": "text",
      "default": ""
    },
    {
      "name": "maxLength",
      "label": "最大长度",
      "type": "number",
      "min": 1
    },
    {
      "name": "bordered",
      "label": "显示边框",
      "type": "boolean",
      "default": true
    }
  ]
}
