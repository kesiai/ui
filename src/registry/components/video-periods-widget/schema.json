{
  "displayName": "录制计划",
  "category": "video",
  "defaultCode": "<VideoPeriodsWidget />",
  "importCode": "import { VideoPeriodsWidget } from '@/components/kesi/video-periods-widget/video-periods-widget';",
  "props": [
    {
      "name": "tableData",
      "label": "设备",
      "type": "json",
      "default": "{}",
      "description": "选择设备表数据"
    },
    {
      "name": "period",
      "label": "周期类型",
      "type": "select",
      "default": "week",
      "options": [
        {
          "value": "week",
          "label": "按周"
        },
        {
          "value": "everyday",
          "label": "每天"
        }
      ]
    },
    {
      "name": "recordingMode",
      "label": "录制模式",
      "type": "select",
      "default": "CMR",
      "options": [
        {
          "value": "CMR",
          "label": "连续录制"
        },
        {
          "value": "ALARM",
          "label": "报警录制"
        },
        {
          "value": "MANUAL",
          "label": "手动录制"
        }
      ]
    },
    {
      "name": "showActions",
      "label": "显示操作按钮",
      "type": "boolean",
      "default": true,
      "description": "是否显示添加、清空等操作按钮"
    },
    {
      "name": "readonly",
      "label": "只读模式",
      "type": "boolean",
      "default": false,
      "description": "是否启用只读模式，禁用所有编辑功能"
    }
  ]
}
