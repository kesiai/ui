{
  "displayName": "操作集合",
  "category": "view",
  "defaultCode": "<Actions />",
  "importCode": "import { Actions } from '@/components/kesi/view-actions/view-actions';",
  "props": [
    {
      "name": "modelName",
      "label": "内置模型",
      "type": "model-name",
      "default": null,
      "description": "内置模型的选择"
    },
    {
      "name": "tableId",
      "label": "表格ID",
      "type": "table-id",
      "default": "user",
      "description": "数据表格的唯一标识符"
    },
    {
      "name": "itemId",
      "label": "数据ID",
      "type": "text",
      "default": "692004b03b11710131077e40",
      "description": "要操作的数据ID（view/edit/delete/export/copy 需要）"
    },
    {
      "name": "actions",
      "label": "操作项",
      "type": "array",
      "default": [
        "create",
        "view",
        "edit",
        "delete",
        "export",
        "copy"
      ],
      "description": "启用的操作（可多选）",
      "options": [
        {
          "value": "create",
          "label": "新建"
        },
        {
          "value": "view",
          "label": "查看"
        },
        {
          "value": "edit",
          "label": "编辑"
        },
        {
          "value": "delete",
          "label": "删除"
        },
        {
          "value": "export",
          "label": "导出"
        },
        {
          "value": "copy",
          "label": "复制"
        }
      ]
    },
    {
      "name": "variant",
      "label": "显示形式",
      "type": "select",
      "default": "dropdown",
      "description": "操作按钮的展示方式",
      "options": [
        {
          "value": "buttons",
          "label": "按钮组"
        },
        {
          "value": "dropdown",
          "label": "下拉菜单"
        }
      ]
    },
    {
      "name": "showExample",
      "label": "显示示例",
      "type": "boolean",
      "default": true,
      "description": "是否在预览中显示示例"
    }
  ]
