{
  "displayName": "时间",
  "category": "form",
  "defaultCode": "<FormTime />",
  "importCode": "import { FormTime } from '@/components/kesi/form-time/form-time';",
  "props": [
    {
      "name": "timeFormat",
      "label": "时间格式",
      "type": "select",
      "default": "HH:mm:ss",
      "options": [
        {
          "value": "HH:mm",
          "label": "HH:mm (时:分)"
        },
        {
          "value": "HH:mm:ss",
          "label": "HH:mm:ss (时:分:秒)"
        }
      ]
    },
    {
      "name": "defaultVal",
      "label": "默认值",
      "type": "text",
      "default": "",
      "description": "例如：14:30:00"
    },
    {
      "name": "disabled",
      "label": "禁用",
      "type": "boolean",
      "default": false
    },
    {
      "name": "size",
      "label": "尺寸",
      "type": "select",
      "default": "middle",
      "options": [
        {
          "value": "small",
          "label": "小"
        },
        {
          "value": "middle",
          "label": "中"
        },
        {
          "value": "large",
          "label": "大"
        }
      ]
    }
  ]
}
