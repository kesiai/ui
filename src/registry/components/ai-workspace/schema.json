{
  "displayName": "AI 工作区",
  "category": "business",
  "defaultCode": "<AgentWorkspace />",
  "importCode": "import { AgentWorkspace } from '@/components/kesi/ai-workspace/ai-workspace';",
  "props": [
    {
      "name": "mode",
      "label": "模式",
      "type": "select",
      "default": "agent",
      "description": "agent 走 /eap/agents，task 走 /eap/tasks",
      "options": [
        {
          "value": "agent",
          "label": "智能体工作区"
        },
        {
          "value": "task",
          "label": "任务工作区"
        }
      ]
    },
    {
      "name": "agentId",
      "label": "智能体",
      "type": "agent-id",
      "default": "",
      "description": "选择智能体（模式为\"智能体工作区\"时生效）"
    },
    {
      "name": "taskId",
      "label": "任务",
      "type": "task-id",
      "default": "",
      "description": "选择任务（模式为\"任务工作区\"时生效）"
    }
  ]
}
