{
  "displayName": "区域层",
  "category": "gis",
  "defaultCode": "<GisPolygonDraw />",
  "importCode": "import { GisPolygonDraw } from '@/components/kesi/gis-polygon-draw/gis-polygon-draw';",
  "props": [
    {
      "name": "data",
      "label": "绘制数据",
      "type": "text",
      "default": "",
      "description": "要素数据"
    },
    {
      "name": "defaultStyle.line.color",
      "label": "线颜色",
      "type": "color",
      "default": "rgba(255, 0, 0, 0.8)"
    },
    {
      "name": "defaultStyle.line.width",
      "label": "线宽",
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 20
    },
    {
      "name": "defaultStyle.line.snumber",
      "label": "线显示序号",
      "type": "boolean",
      "default": false
    },
    {
      "name": "defaultStyle.polygon.color",
      "label": "多边形边框颜色",
      "type": "color",
      "default": "rgba(255, 0, 0, 0.8)"
    },
    {
      "name": "defaultStyle.polygon.width",
      "label": "多边形边框宽度",
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 20
    },
    {
      "name": "defaultStyle.polygon.fillColor",
      "label": "多边形填充颜色",
      "type": "color",
      "default": "rgba(255, 0, 0, 0.2)"
    },
    {
      "name": "defaultStyle.polygon.snumber",
      "label": "多边形显示序号",
      "type": "boolean",
      "default": false
    },
    {
      "name": "display",
      "label": "显示",
      "type": "boolean",
      "default": true
    }
  ]
}
