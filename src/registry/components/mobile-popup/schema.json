{
  "displayName": "弹出框",
  "category": "mobile",
  "defaultCode": "<MobilePopup />",
  "importCode": "import { MobilePopup } from '@/components/kesi/mobile-popup/mobile-popup';",
  "props": [
    {
      "name": "text",
      "label": "按钮文字",
      "type": "text",
      "default": "弹出框"
    },
    {
      "name": "title",
      "label": "标题",
      "type": "text",
      "default": ""
    },
    {
      "name": "position",
      "label": "抽屉位置",
      "type": "select",
      "default": "bottom",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "right",
          "label": "右"
        },
        {
          "value": "top",
          "label": "上"
        },
        {
          "value": "bottom",
          "label": "下"
        }
      ]
    },
    {
      "name": "mask",
      "label": "显示蒙层",
      "type": "boolean",
      "default": true
    },
    {
      "name": "showCloseButton",
      "label": "显示关闭按钮",
      "type": "boolean",
      "default": false
    },
    {
      "name": "showFormSubmitBtn",
      "label": "保存按钮",
      "type": "boolean",
      "default": false,
      "description": "可将子元素[数据表单]的[保存]按钮显示在底部"
    },
    {
      "name": "showFormCancelBtn",
      "label": "取消按钮",
      "type": "boolean",
      "default": false,
      "description": "可将子元素[数据表单]的[取消]按钮显示在底部"
    }
  ]
}
