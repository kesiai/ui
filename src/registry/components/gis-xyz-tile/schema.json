{
  "displayName": "GisXyzTile层",
  "category": "gis",
  "defaultCode": "<GisXyzTile />",
  "importCode": "import { GisXyzTile } from '@/components/kesi/gis-xyz-tile/gis-xyz-tile';",
  "props": [
    {
      "name": "source",
      "label": "瓦片源地址",
      "type": "text",
      "default": "http://wprd0{1-4}.is.autonavi.com/appmaptile?lang=zh_cn&size=1&style=7&x={x}&y={y}&z={z}",
      "placeholder": "请输入 GisXyzTile 瓦片服务地址"
    },
    {
      "name": "coordinateType",
      "label": "坐标系",
      "type": "select",
      "default": "EPSG:3857",
      "options": [
        {
          "value": "EPSG:3857",
          "label": "Web Mercator (EPSG:3857)"
        },
        {
          "value": "EPSG:4326",
          "label": "WGS84 (EPSG:4326)"
        },
        {
          "value": "GCJ02",
          "label": "GCJ02 (火星坐标)"
        },
        {
          "value": "BD09",
          "label": "BD09 (百度坐标)"
        }
      ]
    },
    {
      "name": "coorDefs",
      "label": "坐标系注册",
      "type": "text",
      "default": "{}",
      "placeholder": "{\"defs\": \"...\", \"extent\": [], \"dataProjection\": \"EPSG:...\"}"
    },
    {
      "name": "display",
      "label": "是否显示",
      "type": "boolean",
      "default": true
    },
    {
      "name": "canvasFilter",
      "label": "启用滤镜",
      "type": "boolean",
      "default": false
    },
    {
      "name": "grayscale",
      "label": "灰度 (0-100)",
      "type": "number",
      "default": 98,
      "min": 0,
      "max": 100
    },
    {
      "name": "invert",
      "label": "反色 (0-100)",
      "type": "number",
      "default": 100,
      "min": 0,
      "max": 100
    },
    {
      "name": "sepia",
      "label": "褐色 (0-100)",
      "type": "number",
      "default": 20,
      "min": 0,
      "max": 100
    },
    {
      "name": "hueRotate",
      "label": "色相旋转 (0-360)",
      "type": "number",
      "default": 180,
      "min": 0,
      "max": 360
    },
    {
      "name": "saturate",
      "label": "饱和度 (0-3000)",
      "type": "number",
      "default": 1600,
      "min": 0,
      "max": 3000
    },
    {
      "name": "brightness",
      "label": "亮度 (0-500)",
      "type": "number",
      "default": 80,
      "min": 0,
      "max": 500
    },
    {
      "name": "contrast",
      "label": "对比度 (0-500)",
      "type": "number",
      "default": 90,
      "min": 0,
      "max": 500
    },
    {
      "name": "opacity",
      "label": "透明度",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "zIndex",
      "label": "层级",
      "type": "number",
      "default": 0
    },
    {
      "name": "minZoom",
      "label": "最小缩放",
      "type": "number",
      "default": 0
    },
    {
      "name": "maxZoom",
      "label": "最大缩放",
      "type": "number",
      "default": 18
    }
  ]
}
