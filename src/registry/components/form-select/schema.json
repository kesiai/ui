{
  "displayName": "下拉框",
  "category": "form",
  "defaultCode": "<FormSelect />",
  "importCode": "import { FormSelect } from '@/components/kesi/form-select/form-select';",
  "props": [
    {
      "name": "placeholder",
      "label": "占位符",
      "type": "text",
      "default": "请选择"
    },
    {
      "name": "options",
      "label": "选项列表",
      "type": "array",
      "default": [
        {
          "value": "option1",
          "label": "选项1"
        },
        {
          "value": "option2",
          "label": "选项2"
        },
        {
          "value": "option3",
          "label": "选项3"
        }
      ],
      "description": "选项数组，格式：[{value: \"value\", label: \"显示文本\"}]"
    },
    {
      "name": "selectFace",
      "label": "选择器外观",
      "type": "select",
      "default": "select",
      "description": "选择器显示方式（兼容 table-field）",
      "options": [
        {
          "value": "select",
          "label": "下拉框"
        },
        {
          "value": "flat",
          "label": "平铺"
        },
        {
          "value": "button",
          "label": "按钮组"
        }
      ]
    },
    {
      "name": "selectType",
      "label": "选择类型",
      "type": "select",
      "default": "single",
      "description": "单选或多选（兼容 table-field）",
      "options": [
        {
          "value": "single",
          "label": "单选"
        },
        {
          "value": "multiple",
          "label": "多选"
        }
      ]
    },
    {
      "name": "dataType",
      "label": "数据类型",
      "type": "select",
      "default": "string",
      "description": "值的数据类型（兼容 table-field）",
      "options": [
        {
          "value": "string",
          "label": "字符串"
        },
        {
          "value": "number",
          "label": "数字"
        }
      ]
    },
    {
      "name": "defaultVal",
      "label": "默认值",
      "type": "text",
      "default": "",
      "description": "默认值（兼容 table-field）"
    },
    {
      "name": "size",
      "label": "尺寸",
      "type": "select",
      "default": "default",
      "options": [
        {
          "value": "sm",
          "label": "小"
        },
        {
          "value": "default",
          "label": "标准"
        }
      ]
    },
    {
      "name": "disabled",
      "label": "禁用",
      "type": "boolean",
      "default": false
    },
    {
      "name": "readOnly",
      "label": "只读",
      "type": "boolean",
      "default": false
    },
    {
      "name": "bordered",
      "label": "显示边框",
      "type": "boolean",
      "default": true
    },
    {
      "name": "allowClear",
      "label": "显示清除按钮",
      "type": "boolean",
      "default": false
    },
    {
      "name": "showSearch",
      "label": "支持搜索",
      "type": "boolean",
      "default": false
    },
    {
      "name": "autoFocus",
      "label": "自动获取焦点",
      "type": "boolean",
      "default": false
    },
    {
      "name": "defaultOpen",
      "label": "默认展开",
      "type": "boolean",
      "default": false
    },
    {
      "name": "dropdownMatchSelectWidth",
      "label": "下拉菜单和选择器同宽",
      "type": "boolean",
      "default": true
    }
  ]
}
