{
  "displayName": "日历",
  "category": "mobile",
  "defaultCode": "<MobileCalendar />",
  "importCode": "import { MobileCalendar } from '@/components/kesi/mobile-calendar/mobile-calendar';",
  "props": [
    {
      "name": "mode",
      "label": "模式",
      "type": "select",
      "default": "picker",
      "options": [
        {
          "value": "picker",
          "label": "选择器"
        },
        {
          "value": "calendar",
          "label": "日历"
        }
      ]
    },
    {
      "name": "selectionMode",
      "label": "类型",
      "type": "select",
      "default": "single",
      "options": [
        {
          "value": "single",
          "label": "单日"
        },
        {
          "value": "range",
          "label": "日期区间"
        }
      ]
    },
    {
      "name": "min",
      "label": "最小日期",
      "type": "text",
      "default": ""
    },
    {
      "name": "max",
      "label": "最大日期",
      "type": "text",
      "default": ""
    },
    {
      "name": "allowClear",
      "label": "允许清除",
      "type": "boolean",
      "default": true,
      "description": "是否允许再次点击后清除"
    },
    {
      "name": "placeholder",
      "label": "占位符",
      "type": "text",
      "default": "请选择"
    },
    {
      "name": "disabled",
      "label": "禁用状态",
      "type": "boolean",
      "default": false
    }
  ]
}
