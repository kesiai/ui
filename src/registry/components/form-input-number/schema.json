{
  "displayName": "数字输入框",
  "category": "form",
  "defaultCode": "<FormInputNumber />",
  "importCode": "import { FormInputNumber } from '@/components/kesi/form-input-number/form-input-number';",
  "props": [
    {
      "name": "placeholder",
      "label": "占位符",
      "type": "text",
      "default": "请输入数字"
    },
    {
      "name": "variant",
      "label": "样式变体",
      "type": "select",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "默认"
        },
        {
          "value": "outline",
          "label": "边框"
        },
        {
          "value": "filled",
          "label": "填充"
        },
        {
          "value": "ghost",
          "label": "幽灵"
        }
      ]
    },
    {
      "name": "size",
      "label": "尺寸",
      "type": "select",
      "default": "md",
      "options": [
        {
          "value": "sm",
          "label": "小"
        },
        {
          "value": "md",
          "label": "中"
        },
        {
          "value": "lg",
          "label": "大"
        }
      ]
    },
    {
      "name": "disabled",
      "label": "禁用",
      "type": "boolean",
      "default": false
    },
    {
      "name": "readOnly",
      "label": "只读",
      "type": "boolean",
      "default": false
    },
    {
      "name": "bordered",
      "label": "显示边框",
      "type": "boolean",
      "default": true
    },
    {
      "name": "autoFocus",
      "label": "自动获取焦点",
      "type": "boolean",
      "default": false
    },
    {
      "name": "min",
      "label": "最小值",
      "type": "number"
    },
    {
      "name": "max",
      "label": "最大值",
      "type": "number"
    },
    {
      "name": "decimal",
      "label": "小数位数",
      "type": "number",
      "default": null,
      "description": "null表示不限制，等同于precision"
    },
    {
      "name": "precision",
      "label": "数值精度",
      "type": "number"
    },
    {
      "name": "step",
      "label": "步长",
      "type": "number",
      "default": 1
    },
    {
      "name": "defaultVal",
      "label": "默认值",
      "type": "number",
      "default": 0
    },
    {
      "name": "unit",
      "label": "单位",
      "type": "text",
      "default": "",
      "description": "显示在输入框右侧的单位"
    },
    {
      "name": "prefix",
      "label": "前缀",
      "type": "text",
      "default": ""
    },
    {
      "name": "suffix",
      "label": "后缀",
      "type": "text",
      "default": ""
    },
    {
      "name": "addonBefore",
      "label": "前置标签",
      "type": "text",
      "default": ""
    },
    {
      "name": "addonAfter",
      "label": "后置标签",
      "type": "text",
      "default": ""
    }
  ]
}
