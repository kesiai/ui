{
  "displayName": "标签页",
  "category": "containers",
  "defaultCode": "<Tabs />",
  "importCode": "import { Tabs } from '@/components/kesi/container-tabs/container-tabs';",
  "props": [
    {
      "name": "tabs",
      "label": "标签配置",
      "type": "array",
      "default": [
        {
          "title": "标签 1",
          "icon": "",
          "selectedIcon": ""
        },
        {
          "title": "标签 2",
          "icon": "",
          "selectedIcon": ""
        },
        {
          "title": "标签 3",
          "icon": "",
          "selectedIcon": ""
        }
      ],
      "description": "配置标签页的标题和图标"
    },
    {
      "name": "orientation",
      "label": "标签位置",
      "type": "select",
      "default": "top",
      "description": "标签位于标签页容器的位置",
      "options": [
        {
          "value": "top",
          "label": "上"
        },
        {
          "value": "bottom",
          "label": "下"
        },
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "right",
          "label": "右"
        }
      ]
    },
    {
      "name": "variant",
      "label": "标签样式",
      "type": "select",
      "default": "line",
      "description": "标签的视觉样式",
      "options": [
        {
          "value": "line",
          "label": "下划线页签"
        },
        {
          "value": "card",
          "label": "卡片式页签"
        }
      ]
    },
    {
      "name": "defaultValue",
      "label": "默认激活标签",
      "type": "select",
      "default": "tab-0",
      "description": "默认激活的标签页",
      "options": [
        {
          "value": "tab-0",
          "label": "标签 1"
        },
        {
          "value": "tab-1",
          "label": "标签 2"
        },
        {
          "value": "tab-2",
          "label": "标签 3"
        }
      ]
    },
    {
      "name": "destroyInactiveTabPane",
      "label": "隐藏销毁",
      "type": "boolean",
      "default": false,
      "description": "标签隐藏时销毁内容，如果标签内有图表组件，建议设置为\"是\""
    }
  ]
}
