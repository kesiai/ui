{
  "displayName": "滑动输入条",
  "category": "form",
  "defaultCode": "<FormSlider />",
  "importCode": "import { FormSlider } from '@/components/kesi/form-slider/form-slider';",
  "props": [
    {
      "name": "value",
      "label": "初始值",
      "type": "text",
      "default": "0",
      "description": "单个值或数组值，用逗号分隔多个值"
    },
    {
      "name": "disabled",
      "label": "禁用",
      "type": "boolean",
      "default": false
    },
    {
      "name": "readOnly",
      "label": "只读",
      "type": "boolean",
      "default": false
    },
    {
      "name": "min",
      "label": "最小值",
      "type": "number",
      "default": 0
    },
    {
      "name": "max",
      "label": "最大值",
      "type": "number",
      "default": 100
    },
    {
      "name": "step",
      "label": "步长",
      "type": "number",
      "default": 1,
      "min": 0
    },
    {
      "name": "range",
      "label": "双滑块模式",
      "type": "boolean",
      "default": false
    },
    {
      "name": "dots",
      "label": "拖拽到刻度上",
      "type": "boolean",
      "default": false
    },
    {
      "name": "vertical",
      "label": "垂直方向",
      "type": "boolean",
      "default": false
    },
    {
      "name": "reverse",
      "label": "反向坐标轴",
      "type": "boolean",
      "default": false
    },
    {
      "name": "marks",
      "label": "刻度标记",
      "type": "array",
      "default": []
    }
  ]
}
