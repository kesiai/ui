{
  "displayName": "表数据源",
  "category": "data-source",
  "defaultCode": "<DatasourceTable />",
  "importCode": "import { DatasourceTable } from '@/components/kesi/datasource-table/datasource-table';",
  "props": [
    {
      "name": "id",
      "label": "数据源ID",
      "type": "input",
      "default": "datasource-table",
      "description": "数据源唯一标识符"
    },
    {
      "name": "selectType",
      "label": "选择类型",
      "type": "select",
      "default": "table",
      "description": "数据源选择类型",
      "options": [
        {
          "value": "table",
          "label": "表"
        },
        {
          "value": "dataset",
          "label": "数据集"
        }
      ]
    },
    {
      "name": "table",
      "label": "数据表",
      "type": "object",
      "description": "数据表信息（id, name 等）"
    },
    {
      "name": "isGroup",
      "label": "是否分组",
      "type": "boolean",
      "default": false,
      "description": "是否进行分组查询"
    },
    {
      "name": "feildFormat",
      "label": "字段格式",
      "type": "array",
      "default": [
        {
          "field": {
            "title": "通信时间（connectTime）",
            "value": "connectTime",
            "type": "schema",
            "id": "connectTime",
            "name": "通信时间",
            "propertyType": "string"
          },
          "format": {
            "type": "date",
            "format": "YYYY-MM-DD hh:mm:ss"
          }
        }
      ],
      "description": "字段格式化配置"
    },
    {
      "name": "submit",
      "label": "提交标识",
      "type": "input",
      "default": "",
      "description": "用于触发数据刷新的标识符"
    }
  ]
}
