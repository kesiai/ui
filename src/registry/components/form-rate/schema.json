{
  "displayName": "星级评价",
  "category": "form",
  "defaultCode": "<Rate />",
  "importCode": "import { Rate } from '@/components/kesi/form-rate/form-rate.tsx';",
  "props": [
    {
      "name": "count",
      "label": "星星总数",
      "type": "range",
      "default": 5,
      "description": "超过5级将使用线条模式（兼容 table-field）",
      "min": 1,
      "max": 10
    },
    {
      "name": "defaultVal",
      "label": "默认值",
      "type": "number",
      "default": 0,
      "description": "兼容 table-field 配置"
    },
    {
      "name": "inList",
      "label": "在列表中",
      "type": "boolean",
      "default": false,
      "description": "在表格列表中显示时的样式（兼容 table-field）"
    },
    {
      "name": "disabled",
      "label": "禁用",
      "type": "boolean",
      "default": false
    },
    {
      "name": "allowClear",
      "label": "允许清除",
      "type": "boolean",
      "default": true
    },
    {
      "name": "showScore",
      "label": "显示分数",
      "type": "boolean",
      "default": false
    },
    {
      "name": "size",
      "label": "大小",
      "type": "select",
      "default": "md",
      "options": [
        {
          "value": "sm",
          "label": "小"
        },
        {
          "value": "md",
          "label": "中"
        },
        {
          "value": "lg",
          "label": "大"
        }
      ]
    }
  ]
}
