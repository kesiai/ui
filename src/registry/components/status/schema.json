{
  "displayName": "状态指示器",
  "category": "basic",
  "defaultCode": "<Status />",
  "importCode": "import { Status } from '@/components/kesi/status/status';",
  "props": [
    {
      "name": "value",
      "label": "当前值",
      "type": "select",
      "default": "normal",
      "description": "设置当前状态值，用于匹配不同的状态配置",
      "options": [
        {
          "value": "normal",
          "label": "正常"
        },
        {
          "value": "warning",
          "label": "警告"
        },
        {
          "value": "error",
          "label": "错误"
        },
        {
          "value": "offline",
          "label": "离线"
        }
      ]
    },
    {
      "name": "blinkOnStateChange",
      "label": "状态切换闪烁",
      "type": "boolean",
      "default": false,
      "description": "状态切换时是否触发闪烁动画"
    }
  ]
}
