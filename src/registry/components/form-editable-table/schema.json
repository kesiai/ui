{
  "displayName": "可编辑表格",
  "category": "form",
  "defaultCode": "<FormEditableTable />",
  "importCode": "import { FormEditableTable } from '@/components/kesi/form-editable-table/form-editable-table';",
  "props": [
    {
      "name": "disabled",
      "label": "禁用",
      "type": "boolean",
      "default": false
    },
    {
      "name": "minCount",
      "label": "最小行数",
      "type": "number",
      "default": 0
    },
    {
      "name": "maxCount",
      "label": "最大行数",
      "type": "number",
      "default": 100
    },
    {
      "name": "displayForm",
      "label": "显示方式",
