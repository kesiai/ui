        }
      ]
    },
    {
      "name": "cardLayout",
      "label": "卡片布局",
      "type": "select",
      "default": "3",
      "options": [
        {
          "value": "1",
          "label": "1列"
        },
        {
          "value": "2",
          "label": "2列"
        },
        {
          "value": "3",
          "label": "3列"
        }
      ]
    }
  ]
}
