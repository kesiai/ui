{
  "displayName": "按钮",
  "description": "自定义按钮（文字/样式/尺寸/表单提交）",
  "category": "basic",
  "icon": "button",
  "defaultCode": "<Button />",
  "importCode": "import { Button } from '@/components/kesi/button/button';",
  "props": [
    {
      "name": "text",
      "label": "按钮文字",
      "type": "text",
      "default": "按钮",
      "placeholder": "请输入按钮文字",
      "group": "基础"
    },
    {
      "name": "variant",
      "label": "按钮样式",
      "type": "select",
      "default": "default",
      "options": [
        { "value": "default", "label": "默认" },
        { "value": "destructive", "label": "危险" },
        { "value": "outline", "label": "轮廓" },
        { "value": "secondary", "label": "次要" },
        { "value": "ghost", "label": "幽灵" },
        { "value": "link", "label": "链接" }
      ],
      "group": "基础"
    },
    {
      "name": "size",
      "label": "按钮尺寸",
      "type": "select",
      "default": "default",
      "options": [
        { "value": "default", "label": "默认" },
        { "value": "sm", "label": "小" },
        { "value": "lg", "label": "大" },
        { "value": "icon", "label": "图标" }
      ],
      "group": "基础"
    },
    {
      "name": "border",
      "label": "隐藏边框",
      "type": "boolean",
      "default": false,
      "description": "点击是，按钮无边框",
      "group": "基础"
    },
    {
      "name": "disable",
      "label": "禁用状态",
      "type": "boolean",
      "default": false,
      "description": "可以用来实现隐藏按钮功能",
      "group": "状态"
    },
    {
      "name": "loading",
      "label": "加载状态",
      "type": "boolean",
      "default": false,
      "group": "状态"
    },
    {
      "name": "isSubmit",
      "label": "表单提交键",
      "type": "boolean",
      "default": false,
      "description": "点击是，按钮为表单提交按钮，和表单配合使用的情况下可使用此功能",
      "group": "表单"
    },
    {
      "name": "isReset",
      "label": "表单重置键",
      "type": "boolean",
      "default": false,
      "description": "点击是，按钮为表单重置按钮，和表单配合使用的情况下可使用此功能",
      "group": "表单"
    }
  ]
}
