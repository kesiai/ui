      "default": "out",
      "options": [
        {
          "value": "in",
          "label": "内部链接"
        },
        {
          "value": "out",
          "label": "外部链接"
        }
      ]
    },
    {
      "name": "placeholder",
      "label": "占位符",
      "type": "text",
      "default": "请输入链接"
    },
    {
      "name": "defaultVal",
      "label": "默认值",
      "type": "text",
      "default": ""
    },
    {
      "name": "disabled",
      "label": "禁用",
      "type": "boolean",
      "default": false
    }
  ]
