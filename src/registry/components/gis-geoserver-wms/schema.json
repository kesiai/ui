{
  "displayName": "WMS层",
  "category": "gis",
  "defaultCode": "<GisGeoserverWms />",
  "importCode": "import { GisGeoserverWms } from '@/components/kesi/gis-geoserver-wms/gis-geoserver-wms';",
  "props": [
    {
      "name": "source",
      "label": "服务地址",
      "type": "text",
      "default": "http://localhost:8080/geoserver/wms",
      "description": "GeoServer WMS服务地址",
      "placeholder": "WMS 服务地址 URL"
    },
    {
      "name": "VERSION",
      "label": "WMS版本",
      "type": "select",
      "default": "1.1.0",
      "description": "WMS服务版本号",
      "options": [
        {
          "value": "1.1.0",
          "label": "1.1.0"
        },
        {
          "value": "1.1.1",
          "label": "1.1.1"
        },
        {
          "value": "1.3.0",
          "label": "1.3.0"
        }
      ]
    },
    {
      "name": "layers",
      "label": "图层名称",
      "type": "text",
      "default": "workspace:layer",
      "description": "WMS图层名称，格式：workspace:layer",
      "placeholder": "WMS 图层名称(LAYERS)"
    },
    {
      "name": "coordinateType",
      "label": "投影类型",
      "type": "select",
      "default": "EPSG:4326",
      "description": "地图投影类型",
      "options": [
        {
          "value": "EPSG:4326",
          "label": "EPSG:4326 (经纬度)"
        },
        {
          "value": "EPSG:3857",
          "label": "EPSG:3857 (墨卡托)"
        },
        {
          "value": "WGS84",
          "label": "WGS84"
        },
        {
          "value": "WGS1984",
          "label": "WGS1984"
        },
        {
          "value": "EPSG:900913",
          "label": "EPSG:900913"
        },
        {
          "value": "EPSG:102100",
          "label": "EPSG:102100"
        },
        {
          "value": "WebMercator",
          "label": "WebMercator"
        }
      ]
    },
    {
      "name": "display",
      "label": "是否显示",
      "type": "boolean",
      "default": true
    },
    {
      "name": "opacity",
      "label": "透明度",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "zIndex",
      "label": "层级",
      "type": "number",
      "default": 0
    },
    {
      "name": "minZoom",
      "label": "最小缩放",
      "type": "number",
      "default": 0
    },
    {
      "name": "maxZoom",
      "label": "最大缩放",
      "type": "number",
      "default": 18
    }
  ]
}
