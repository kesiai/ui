{
  "displayName": "地图定位",
  "category": "form",
  "defaultCode": "<FormMap />",
  "importCode": "import { FormMap } from '@/components/kesi/form-map/form-map';",
  "props": [
    {
      "name": "placeholder",
      "label": "占位符",
      "type": "text",
      "default": "请选择位置"
    },
    {
      "name": "lngLat",
      "label": "显示经纬度",
      "type": "boolean",
      "default": true
    },
    {
      "name": "positionName",
      "label": "显示位置名称",
      "type": "boolean",
      "default": true
    },
    {
      "name": "canEdit",
      "label": "可编辑",
      "type": "boolean",
      "default": true
    },
    {
      "name": "canHand",
      "label": "可手动输入",
      "type": "boolean",
      "default": true
    },
    {
      "name": "showType",
      "label": "展示方式",
      "type": "select",
      "default": "modal",
      "options": [
        {
          "value": "modal",
          "label": "弹窗"
        },
        {
          "value": "map",
          "label": "直接显示地图"
        }
      ]
    },
    {
      "name": "size",
      "label": "尺寸",
      "type": "select",
      "default": "middle",
      "options": [
        {
          "value": "small",
          "label": "小"
        },
        {
          "value": "middle",
          "label": "中"
        },
        {
          "value": "large",
          "label": "大"
        }
      ]
    }
  ]
}
