{
  "displayName": "链接",
  "category": "form",
  "defaultCode": "<FormLink />",
  "importCode": "import { FormLink } from '@/components/kesi/form-link/form-link';",
  "props": [
    {
      "name": "linkType",
      "label": "链接类型",
