{
  "displayName": "GeoJSON层",
  "category": "gis",
  "defaultCode": "<GisGeoJsonParse />",
  "importCode": "import { GisGeoJsonParse } from '@/components/kesi/gis-geojson-parse/gis-geojson-parse';",
  "props": [
    {
      "name": "source",
      "label": "GeoJSON URL",
      "type": "text",
      "default": "",
      "description": "GeoJSON 文件地址",
      "placeholder": "GeoJSON 数据地址"
    },
    {
      "name": "coordinateType",
      "label": "坐标系",
      "type": "select",
      "default": "EPSG:4326",
      "options": [
        {
          "value": "EPSG:4326",
          "label": "EPSG:4326 (WGS84)"
        },
        {
          "value": "EPSG:3857",
          "label": "EPSG:3857 (WebMercator)"
        },
        {
          "value": "GCJ02",
          "label": "GCJ02 (火星坐标)"
        },
        {
          "value": "BD09",
          "label": "BD09 (百度坐标)"
        }
      ]
    },
    {
      "name": "lineStyle.color",
      "label": "线条颜色",
      "type": "color",
      "default": "rgba(255, 0, 0, 1)"
    },
    {
      "name": "lineStyle.width",
      "label": "线条宽度",
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 20
    },
    {
      "name": "lineStyle.background",
      "label": "填充颜色",
      "type": "color",
      "default": "rgba(255, 255, 255, 0.2)"
    },
    {
      "name": "display",
      "label": "是否显示",
      "type": "boolean",
      "default": true
    },
    {
      "name": "opacity",
      "label": "透明度",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "zIndex",
      "label": "层级",
      "type": "number",
      "default": 0
    }
  ]
}
